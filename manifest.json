{
  "manifest_version": 3,
  "name": "Watch Later Extension for YouTube",
  "description": "Don't just save YouTube videos to watch later, actually watch them!",
  "version": "1.1.5",
  "key": "",
  "icons": {
    "16": "Icon/WatchLater.png",
    "48": "Icon/WatchLater.png",
    "128": "Icon/WatchLater.png"
  },
  "permissions": [
    "identity",
    "storage",
    "alarms",
    "activeTab",
    "scripting",
    "tabs",
    "declarativeNetRequestWithHostAccess"
  ],
  "oauth2": {
  "client_id": "392838470948-g3utd3qn171c9tdgjevg27pceasan4gm.apps.googleusercontent.com",
  "scopes": ["https://www.googleapis.com/auth/calendar", "https://www.googleapis.com/auth/userinfo.email"]
},
  "host_permissions": [
    "https://ayzqfwtoeckgycmqzlve.supabase.co/*",
    "https://*.youtube.com/*",
    "https://www.youtube-nocookie.com/*",
    "https://i.ytimg.com/*",
    "https://www.googleapis.com/*",
    "https://www.googleapis.com/auth/calendar"
  ],
  "background": {
    "service_worker": "background.js"
  },
  
"action": {
  "default_popup": "popup.html"
},
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-src https://www.youtube.com https://www.youtube-nocookie.com;"
  },
  "web_accessible_resources": [
    {
      "resources": ["ding.mp3"],
      "matches": ["<all_urls>"]
    }
  ] 
}